// Test sample for amalgame-math.
//
// Avoid the bare keyword "ns"+"pace" in comments — amc's
// first-pass scan grabs the first occurrence and uses the
// following identifier as the bundle prefix.

namespace UserApp

import Amalgame.Math

public class Program {
    public static void Main() {
        let s: float = Math.Sqrt(16.0)
        if (s == 4.0) { Console.WriteLine("[PASS] sqrt 16") } else { Console.WriteLine("[FAIL] sqrt got " + String_FromFloat(s)) }

        let p: int = Math.PowI(2, 10)
        if (p == 1024) { Console.WriteLine("[PASS] powI 2^10") } else { Console.WriteLine("[FAIL] powI got " + String_FromInt(p)) }

        if (Math.AbsI(-42) == 42) { Console.WriteLine("[PASS] absI -42") } else { Console.WriteLine("[FAIL] absI") }
        if (Math.MaxI(10, 42) == 42) { Console.WriteLine("[PASS] maxI") } else { Console.WriteLine("[FAIL] maxI") }
        if (Math.MinI(10, 42) == 10) { Console.WriteLine("[PASS] minI") } else { Console.WriteLine("[FAIL] minI") }
        if (Math.ClampI(150, 0, 100) == 100) { Console.WriteLine("[PASS] clampI") } else { Console.WriteLine("[FAIL] clampI") }
        if (Math.Gcd(48, 18) == 6) { Console.WriteLine("[PASS] gcd 48,18") } else { Console.WriteLine("[FAIL] gcd") }
        if (Math.IsPrime(17)) { Console.WriteLine("[PASS] prime 17") } else { Console.WriteLine("[FAIL] prime 17") }
        if (!Math.IsPrime(18)) { Console.WriteLine("[PASS] not prime 18") } else { Console.WriteLine("[FAIL] not prime 18") }
        if (Math.IsFinite(1.0)) { Console.WriteLine("[PASS] finite 1.0") } else { Console.WriteLine("[FAIL] finite") }

        let pi: float = Math.PI()
        if (pi > 3.1415 && pi < 3.1416) { Console.WriteLine("[PASS] PI") } else { Console.WriteLine("[FAIL] PI") }
    }
}
